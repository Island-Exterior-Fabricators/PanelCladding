#!/bin/sh
ps=powershell.exe
command -v "$ps" >/dev/null 2>&1 || ps=pwsh
"$ps" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$(dirname "$0")/Test-RepositoryContent.ps1" -Mode Push -Remote "$1" || exit 1
exec "$ps" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tools/check.ps1 </dev/null
