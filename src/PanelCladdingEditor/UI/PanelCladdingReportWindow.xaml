<Window x:Class="PanelCladdingEditor.UI.PanelCladdingReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Report"
        Width="1180" Height="760" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FAFBFC" Foreground="#263239"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#263239" />
        <SolidColorBrush x:Key="MutedBrush" Color="#748087" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE3E7" />
        <SolidColorBrush x:Key="HoverBrush" Color="#EEF1F3" />
        <SolidColorBrush x:Key="PressedBrush" Color="#E5EAED" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#E3F1E7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#229447" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#197D3B" />

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CountChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RuleItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="16,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DocumentText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="360" />
                    <Border x:Name="ErrorChip" Style="{StaticResource CountChip}" Background="#FBE4E2" Margin="16,0,0,0">
                        <TextBlock x:Name="ErrorCountText" Foreground="#B2332C" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border x:Name="WarningChip" Style="{StaticResource CountChip}" Background="#FFF0D2">
                        <TextBlock x:Name="WarningCountText" Foreground="#8A5A00" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border x:Name="InfoChip" Style="{StaticResource CountChip}" Background="#EEF1F3">
                        <TextBlock x:Name="InfoCountText" Foreground="#4C585E" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RescanButton" Content="Rescan" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                            Click="OnRescanClick" />
                    <Button x:Name="ExportButton" Content="Export" Style="{StaticResource PrimaryButton}"
                            Click="OnExportClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ListBox x:Name="RuleList" BorderThickness="0" Background="Transparent" Padding="0,8"
                         ItemContainerStyle="{StaticResource RuleItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnRuleSelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="16,12,16,4" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="{Binding SeverityBrush}" VerticalAlignment="Center"
                                         HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="RuleTitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="RuleFixText" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ListView x:Name="IssueList" Grid.Row="1" SelectionMode="Extended" BorderBrush="{StaticResource BorderBrush}"
                          Background="{StaticResource SurfaceBrush}" SelectionChanged="OnIssueSelectionChanged"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Object" Width="150" DisplayMemberBinding="{Binding Object}" />
                            <GridViewColumn Header="Layer" Width="380" DisplayMemberBinding="{Binding Layer}" />
                            <GridViewColumn Header="Detail" Width="520" DisplayMemberBinding="{Binding Detail}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyText" Grid.RowSpan="2" Text="No issues" FontSize="16" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
